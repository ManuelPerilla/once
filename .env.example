# Genera valores privados con: python -m src.configure
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=
# false solo para desarrollo HTTP; usar true detrás de HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=80
# Solo si activas el perfil opcional de administración de PostgreSQL:
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Opcional: activa previews contra API-Football desde el Control Room.
API_FOOTBALL_KEY=
# Wikimedia exige identificar clientes; cambia este valor si despliegas tu propia instancia.
WIKIDATA_USER_AGENT=ONCE/0.2 (personal local football catalog)
