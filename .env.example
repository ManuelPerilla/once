# Genera valores privados con: python -m src.configure
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=
# false solo para desarrollo HTTP; usar true detrás de HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=80
# 127.0.0.1: solo este equipo; 0.0.0.0: compartir en la red local.
# Desde la raíz con Python 3.12 y Docker activo: python -m scripts.network lan
# Otro puerto: python -m scripts.network lan --port 8080
# Consultar: python -m scripts.network status; volver: python -m scripts.network local
# Windows: compartir-once.cmd; --firewall es opcional y requiere administrador.
# El asistente conserva secretos y descubre la IP; no guardes aquí la IP del equipo.
# HTTP local usa COOKIE_SECURE=false; para HTTPS consulta docs/deployment/server.md.
FRONTEND_BIND=127.0.0.1
# Solo si activas el perfil opcional de administración de PostgreSQL:
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Opcional: permite consultar cobertura y sincronizar mediante la cola; requiere verificar el plan.
API_FOOTBALL_KEY=
# Wikimedia exige identificar clientes; cambia este valor si despliegas tu propia instancia.
WIKIDATA_USER_AGENT=ONCE/0.2 (personal local football catalog)
# Historial operativo prescindible; no elimina entidades ni auditoría (mínimo 7 días).
SYNC_RETENTION_DAYS=30
